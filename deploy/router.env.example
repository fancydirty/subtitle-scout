# 路由部署目录 .env 模板。真实值不入 git（本文件是纯模板，不含真值，故入库）。
# ⚠️ 这是**最小必填集 + 常用可选项**；完整可选项清单见仓库根的 .env.example。
#    （去 Jellyfin 化后不再读 JELLYFIN_*；POLL_INTERVAL_SECONDS 已是死配置，已移除。）

# 必填：宿主机媒体库根目录（含 Movies/ TV/ 等子目录）
MEDIA_HOST_PATH=/mnt/nvme0n1-4/nas_media

# 必填：TMDB API key（识别文件、判定季集排布）
TMDB_API_KEY=

# 必填：LLM 配置（字幕候选终审、zimuku 验证码破解）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_EXTRA_BODY=

# 必填：ASSRT token（字幕源）
ASSRT_TOKEN=

# 可选：OpenSubtitles（欧美剧集覆盖比 ASSRT 好）
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# 可选：字幕源开关（默认关）
ZIMUKU_ENABLED=false
SUBHD_ENABLED=false

# 可选：jimaku 日字源
JIMAKU_API_KEY=

# 可选：AI 翻译部署门三件套（缺一 daemon 自动翻译休眠；配齐后还需在设置页打开开关）
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=
# 可选：判官开关/单指定模型/单批超时
TRANSLATE_CRITIC=on
TRANSLATE_CRITIC_MODEL=
TRANSLATE_TIMEOUT_MS=

# 可选：媒体守备目录（容器内路径，首启种子；之后以 dashboard 设置页为准）
MEDIA_ROOTS=/media/movies,/media/tv

# 可选：目标语言 / 扫描节奏 / 日志保留 / 时区（dashboard 设置页优先于前两项）
TARGET_LANGUAGES=
SCAN_INTERVAL_MS=
LOG_RETAIN_DAYS=30
TZ=Asia/Shanghai

# 可选：国产内容跳过（默认 true）
SKIP_CHINESE_ORIGIN=true

# 可选：整理归档根（默认库根上一级；容器默认挂载下建议显式配到同一 bind mount 内，见主 .env.example）
REALIGN_ARCHIVE_ROOT=

# 可选：dashboard 端口 / legacy token（新部署留空，用首启向导设账号密码）
DASHBOARD_PORT=8099
DASHBOARD_TOKEN=

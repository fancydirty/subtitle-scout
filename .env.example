# --- LLM（任意 OpenAI-compatible 端点：OpenAI / DeepSeek / 硅基流动 等）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# --- ASSRT（注册 https://assrt.net → 用户中心复制 token；配额 5 次/分钟，程序已自动限速）---
ASSRT_TOKEN=
# 必填：TMDB API key（免费）——识别文件、判定季集排布、拉全部中文译名变体都靠它，
# 没有这把钥匙 watch/reconcile-all 直接拒绝启动（doctor 也会对缺失/无效的 key 报 ✗）
# 申请：themoviedb.org 注册 → 设置 → API → 申请 Developer key（v3 或 v4 Read Access Token 都支持）
TMDB_API_KEY=
# 可选：TMDB 反代/自定义 API 基址（墙内环境直连 api.themoviedb.org 常被墙时用）
# TMDB_BASE_URL 覆盖 API 基址（默认 https://api.themoviedb.org/3），TMDB_PROXY_URL 走 HTTP 代理
TMDB_BASE_URL=
TMDB_PROXY_URL=
# 可选：OpenSubtitles（欧美剧集覆盖比 ASSRT 好）——不填则该数据源自动跳过，不阻塞主流程
# 申请：opensubtitles.com 注册 → 账号设置 → API Consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# 可选、默认关闭:zimuku 字幕站(灰色地带,条款风险自担)——设为 true 启用,需要同一份 LLM_*
# 配置支持识图(验证码破解需要多模态模型)
ZIMUKU_ENABLED=false
# 可选、默认关闭:subhd 字幕源(通用型中文字幕站,强源)——设为 true 启用。无验证码/无云锁,
# 不需要 LLM;但容器内需 curl+ca-certificates(镜像已自带)——Node TLS 指纹被其临时页拒。
SUBHD_ENABLED=false
# 可选:jimaku.cc 日文字幕专门源(F2 日→中单跳直译的日源)——注册 jimaku.cc → Account → API key。
# 不填则 jimaku adapter 休眠;日漫无内嵌日字时回退英文轨(标记 fallback:)。
JIMAKU_API_KEY=

# --- AI 翻译(agent 工作台:对"搜索穷尽无中字"的条目,用内嵌/外挂源字幕单跳直译中文)---
# ⚠️ daemon 自动翻译部署门:三件套缺一,daemon 自动翻译整体休眠(绝不回退 LLM_*=mimo,太弱)。
#    即使三件套配齐,还需在 dashboard 设置页打开"AI 翻译"开关(默认关,防止意外烧配额)。
# 手动 translate-item 命令不受部署门限制:未配 TRANSLATE_MODEL 时回退使用上面的 LLM_* 配置。
# 模型建议:reasoning 强模型(实测见 docs/design/model-choice-evidence.md——弱模型能过闸但人名随机漂移)
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=
# 可选:语义判官开关(默认开;off 关闭后仅靠确定性质量闸,仍 fail-closed)
TRANSLATE_CRITIC=on
# 可选:判官单指定模型(缺省与 TRANSLATE_MODEL 相同)
TRANSLATE_CRITIC_MODEL=
# 可选:单批翻译超时毫秒(默认 300000)
TRANSLATE_TIMEOUT_MS=
# 目标字幕语言(逗号分隔 BCP-47,默认 zh;dashboard 设置页 target_languages 优先于此)
TARGET_LANGUAGES=
# 可选:缓存目录(仅源码直装生效;compose 部署恒为 /cache,被 docker-compose.yml 硬编码覆盖)
SUBTITLE_SCOUT_CACHE_DIR=
# （可选，高级）逐字段合并进每次 LLM 请求体的 JSON（provider 专属参数逃生舱，如某些端点
# 需要显式关闭 thinking 模式）。通常无需配置。
LLM_EXTRA_BODY=
# --- watch 模式 ---
# 要扫描的媒体根目录（逗号分隔，**容器内**路径）。
# ⚠️ compose 部署把**宿主机根目录**挂到容器的 /hostroot，所以容器内路径 = /hostroot + 宿主机
#    绝对路径。例：宿主机 /mnt/media/Movies → 这里写 /hostroot/mnt/media/Movies。
#    （挂根目录是有意的：用户的目录结构千奇百怪，与其硬编码 Movies/TV，不如让你自己选。）
# ⚠️ 这是唯一的扫描来源（去 Jellyfin 化后不再从媒体服务器发现文件）——留空 = 什么都不扫、
# 媒体库永远为空!必须至少配一个,或部署后在 dashboard 设置页里添加守备目录。
# ⚠️ 重要:此 env 在 media_roots 表为空时播种一次（首启种子）。
#    首次启动后,真正的守备目录列表存在数据库里,改这个 env 不会生效!
#    之后的增删改请去 dashboard 设置页(http://<主机>:8099/settings)。
#    特殊情况:如果你在 dashboard 删光全部守备目录后重启,此 env 会重新播种;
#    想彻底清空需同时清空此 env。
# 默认留空——推荐部署后在 dashboard 设置页用目录浏览器从 /hostroot 里点选，
# 免得手抄路径抄错（浏览器给的路径一定是容器内可达的真实路径）。
MEDIA_ROOTS=
# 可选:自扫描间隔毫秒（默认 900000=15 分钟）。dashboard 设置页的 scan_interval_ms 优先于此。
SCAN_INTERVAL_MS=
# 跳过原产地即目标语言的影视（如目标中文时跳过国产剧,避免为它们空跑找字幕）
SKIP_CHINESE_ORIGIN=true
LOG_RETAIN_DAYS=30
# 容器时区（影响日志与"今天"统计口径）
TZ=Asia/Shanghai
# 可选:整理(realign)归档根——被搬走的旧目录挪到这里,可回滚。默认=库根的上一级。
# 容器挂载形态下通常无需配:宿主机根挂在 /hostroot,库根的上一级同样在 /hostroot 之下,
# 与库同属一个 bind mount,rename 合法(不会有旧形态那种 overlay 层跨设备 EXDEV 问题)。
# 想集中存放时显式配一个 /hostroot 下、与媒体库同一文件系统的路径,例如
# REALIGN_ARCHIVE_ROOT=/hostroot/mnt/media/.realign-archive。
REALIGN_ARCHIVE_ROOT=
# 可选:ffprobe 二进制路径(内嵌字幕/时长探针)。官方镜像已内置 ffmpeg,无需配置;
# 只有源码直装且 PATH 上没有 ffmpeg 时才需要手动指定(缺省回退 ffprobe-static)。
FFPROBE_PATH=
# --- dashboard（可选）---
DASHBOARD_PORT=8099
# 可选：反代部署下信任 x-forwarded-for（登录限流按真实客户端 IP 而不是反代 IP）。
# ⚠️ 只有在你**自己控制**反向代理（如 Caddy/nginx）时才设 true；否则任何人都能伪造 XFF 绕过限流。
#    不设时，所有请求共享反代 IP 一个限流桶：任何人 5 次失败会锁死所有管理员 1 分钟。
TRUST_PROXY=false
# legacy：老部署的访问 token，等价一个 API key（?token=<值> 或 X-Dashboard-Token 头）。
# 新部署建议留空——首次访问监控页会进入创建管理员向导（账号密码 + 自动生成 API key）。
DASHBOARD_TOKEN=

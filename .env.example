# --- LLM（任意 OpenAI-compatible 端点：OpenAI / DeepSeek / 硅基流动 等）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# --- ASSRT（注册 https://assrt.net → 用户中心复制 token；配额 5 次/分钟，程序已自动限速）---
ASSRT_TOKEN=
# 必填：TMDB API key（免费）——识别文件、判定季集排布、拉全部中文译名变体都靠它，
# 没有这把钥匙 watch/reconcile-all 直接拒绝启动（doctor 也会对缺失/无效的 key 报 ✗）
# 申请：themoviedb.org 注册 → 设置 → API → 申请 Developer key（v3 或 v4 Read Access Token 都支持）
TMDB_API_KEY=
# 可选：TMDB 反代/自定义 API 基址（墙内环境直连 api.themoviedb.org 常被墙时用）
# TMDB_BASE_URL 覆盖 API 基址（默认 https://api.themoviedb.org/3），TMDB_PROXY_URL 走 HTTP 代理
TMDB_BASE_URL=
TMDB_PROXY_URL=
# 可选：OpenSubtitles（欧美剧集覆盖比 ASSRT 好）——不填则该数据源自动跳过，不阻塞主流程
# 申请：opensubtitles.com 注册 → 账号设置 → API Consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# 可选、默认关闭:zimuku 字幕站(灰色地带,条款风险自担)——设为 true 启用,需要同一份 LLM_*
# 配置支持识图(验证码破解需要多模态模型)
ZIMUKU_ENABLED=false
# 可选、默认关闭:subhd 字幕源(通用型中文字幕站,强源)——设为 true 启用。无验证码/无云锁,
# 不需要 LLM;但容器内需 curl+ca-certificates(镜像已自带)——Node TLS 指纹被其临时页拒。
SUBHD_ENABLED=false
# 可选:jimaku.cc 日文字幕专门源(F2 日→中单跳直译的日源)——注册 jimaku.cc → Account → API key。
# 不填则 jimaku adapter 休眠;日漫无内嵌日字时回退英文轨(标记 fallback:)。
JIMAKU_API_KEY=

# --- AI 翻译(agent 工作台:对"搜索穷尽无中字"的条目,用内嵌/外挂源字幕单跳直译中文)---
# 三件套是 daemon 自动翻译的部署门(缺一整套功能休眠,手动 translate-item 也不受影响)。
# 未配 TRANSLATE_MODEL 时,翻译回退使用上面的 LLM_* 配置。
# 模型建议:reasoning 强模型(实测见 docs/design/model-choice-evidence.md——弱模型能过闸但人名随机漂移)
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=
# 可选:语义判官开关(默认开;off 关闭后仅靠确定性质量闸,仍 fail-closed)
TRANSLATE_CRITIC=on
# 可选:判官单指定模型(缺省与 TRANSLATE_MODEL 相同)
TRANSLATE_CRITIC_MODEL=
# 可选:单批翻译超时毫秒(默认 300000)
TRANSLATE_TIMEOUT_MS=
# 目标字幕语言(逗号分隔 BCP-47,默认 zh;dashboard 设置页 target_languages 优先于此)
TARGET_LANGUAGES=
SUBTITLE_SCOUT_CACHE_DIR=
# （可选，高级）逐字段合并进每次 LLM 请求体的 JSON（provider 专属参数逃生舱，如某些端点
# 需要显式关闭 thinking 模式）。通常无需配置。
LLM_EXTRA_BODY=
# --- watch 模式 ---
# 要扫描的媒体根目录（逗号分隔，容器内路径），如 /media/movies,/media/tv。
# ⚠️ 这是唯一的扫描来源（去 Jellyfin 化后不再从媒体服务器发现文件）——留空 = 什么都不扫、
# 媒体库永远为空!必须至少配一个,或部署后在 dashboard 设置页里添加守备目录。
# 注意:这里是**容器内**路径,不是宿主机路径!docker-compose 会挂载 MEDIA_HOST_PATH 到容器的
# /media,所以如果你想扫 /media/movies 和 /media/tv,这里就写 "/media/movies,/media/tv"。
# 如果你的媒体库目录结构不同(比如直接挂载到 /media 根),就写 "/media"。
MEDIA_ROOTS=/media/movies,/media/tv
# 可选:自扫描间隔毫秒（默认 900000=15 分钟）。dashboard 设置页的 scan_interval_ms 优先于此。
SCAN_INTERVAL_MS=
# 跳过原产地即目标语言的影视（如目标中文时跳过国产剧,避免为它们空跑找字幕）
SKIP_CHINESE_ORIGIN=true
LOG_RETAIN_DAYS=30
# 容器时区（影响日志与"今天"统计口径）
TZ=Asia/Shanghai
# --- compose 用：宿主机媒体库根目录（含 Movies/ TV/ 等子目录）---
# 必填！改成你的真实路径（/path/to/your/media 只是占位符，不改会挂载出空目录）
# ⚠️ 注意大小写:下面的 MEDIA_ROOTS 是**容器内**路径,docker-compose.yml 会把
# ${MEDIA_HOST_PATH}/Movies 挂载到容器的 /media/movies(小写)。
# 如果你的宿主机目录是 /data/media/Movies(大写),MEDIA_HOST_PATH=/data/media,
# 容器内路径就是 /media/movies(小写),MEDIA_ROOTS 也要写 /media/movies。
# 如果你的媒体库直接在根目录(比如 /data/media 里全是电影电视剧混在一起,没有 Movies/TV 子目录),
# 那就改 docker-compose.yml 的 volumes 部分,改成 ${MEDIA_HOST_PATH}:/media,
# 然后 MEDIA_ROOTS=/media。
MEDIA_HOST_PATH=/path/to/your/media
# --- dashboard（可选）---
DASHBOARD_PORT=8099
# legacy：老部署的访问 token，等价一个 API key（?token=<值> 或 X-Dashboard-Token 头）。
# 新部署建议留空——首次访问监控页会进入创建管理员向导（账号密码 + 自动生成 API key）。
DASHBOARD_TOKEN=

# --- LLM（任意 OpenAI-compatible 端点：OpenAI / DeepSeek / 硅基流动 等）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# --- ASSRT（注册 https://assrt.net → 用户中心复制 token；配额 5 次/分钟，程序已自动限速）---
ASSRT_TOKEN=
# 强烈推荐：TMDB API key（免费）——一次拿到影视的全部中文译名变体，中文搜索召回质变
# 申请：themoviedb.org 注册 → 设置 → API → 申请 Developer key（v3 或 v4 Read Access Token 都支持）
TMDB_API_KEY=
# 可选：OpenSubtitles（欧美剧集覆盖比 ASSRT 好）——不填则该数据源自动跳过，不阻塞主流程
# 申请：opensubtitles.com 注册 → 账号设置 → API Consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# 可选、默认关闭:zimuku 字幕站(灰色地带,条款风险自担)——设为 true 启用,需要同一份 LLM_*
# 配置支持识图(验证码破解需要多模态模型)
ZIMUKU_ENABLED=false
SUBTITLE_SCOUT_CACHE_DIR=
# （可选，高级）逐字段合并进每次 LLM 请求体的 JSON（provider 专属参数逃生舱，如某些端点
# 需要显式关闭 thinking 模式）。通常无需配置。
LLM_EXTRA_BODY=
# --- watch 模式（Jellyfin sidecar）---
# 必填：scout 视角可达的地址。Jellyfin 跑在同一台机器的 Docker 上时，直接用 http://host.docker.internal:8096（compose 已配 extra_hosts，Linux 也通）；其他情况用 http://<Jellyfin主机IP>:8096
JELLYFIN_URL=
# 必填：Jellyfin 控制台 → 高级 → API 密钥 → 新建
JELLYFIN_API_KEY=
MEDIA_PATH_MAPPINGS=
MEDIA_ROOTS=
POLL_INTERVAL_SECONDS=15
ITEM_COOLDOWN_MINUTES=30
TREAT_PGS_AS_MISSING=true
ADOPT_LOCAL_SUBTITLES=true
SKIP_CHINESE_ORIGIN=true
SKIP_CACHE_MINUTES=5
ARRIVALS_POLL_MINUTES=15
PREFETCH_INTERVAL_MINUTES=10
LOG_RETAIN_DAYS=30
# 容器时区（影响日志与"今天"统计口径）
TZ=Asia/Shanghai
# --- compose 用：宿主机媒体库根目录（含 Movies/ TV/ 等子目录）---
# 必填！改成你的真实路径（/path/to/your/media 只是占位符，不改会挂载出空目录）
MEDIA_HOST_PATH=/path/to/your/media
# --- dashboard（可选）---
DASHBOARD_PORT=8099
DASHBOARD_TOKEN=

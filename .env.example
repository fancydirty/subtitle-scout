# --- LLM（任意 OpenAI-compatible 端点：OpenAI / DeepSeek / 硅基流动 等）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# --- ASSRT（注册 https://assrt.net → 用户中心复制 token；配额 5 次/分钟，程序已自动限速）---
ASSRT_TOKEN=
# 必填：TMDB API key（免费）——识别文件、判定季集排布、拉全部中文译名变体都靠它，
# 没有这把钥匙 watch/reconcile-all 直接拒绝启动（doctor 也会对缺失/无效的 key 报 ✗）
# 申请：themoviedb.org 注册 → 设置 → API → 申请 Developer key（v3 或 v4 Read Access Token 都支持）
TMDB_API_KEY=
# 可选：TMDB 反代/自定义 API 基址（墙内环境直连 api.themoviedb.org 常被墙时用）
# TMDB_BASE_URL 覆盖 API 基址（默认 https://api.themoviedb.org/3），TMDB_PROXY_URL 走 HTTP 代理
TMDB_BASE_URL=
TMDB_PROXY_URL=
# 可选：OpenSubtitles（欧美剧集覆盖比 ASSRT 好）——不填则该数据源自动跳过，不阻塞主流程
# 申请：opensubtitles.com 注册 → 账号设置 → API Consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# 可选、默认关闭:zimuku 字幕站(灰色地带,条款风险自担)——设为 true 启用,需要同一份 LLM_*
# 配置支持识图(验证码破解需要多模态模型)
ZIMUKU_ENABLED=false
SUBTITLE_SCOUT_CACHE_DIR=
# （可选，高级）逐字段合并进每次 LLM 请求体的 JSON（provider 专属参数逃生舱，如某些端点
# 需要显式关闭 thinking 模式）。通常无需配置。
LLM_EXTRA_BODY=
# --- watch 模式 ---
# 要扫描的媒体根目录（逗号分隔），如 /media/movies,/media/tv。
# ⚠️ 这是唯一的扫描来源（去 Jellyfin 化后不再从媒体服务器发现文件）——留空 = 什么都不扫、
# 媒体库永远为空!必须至少配一个,或部署后在 dashboard 设置页里添加守备目录。
MEDIA_ROOTS=
# 可选:自扫描间隔毫秒（默认 900000=15 分钟）。dashboard 设置页的 scan_interval_ms 优先于此。
SCAN_INTERVAL_MS=
# 跳过原产地即目标语言的影视（如目标中文时跳过国产剧,避免为它们空跑找字幕）
SKIP_CHINESE_ORIGIN=true
LOG_RETAIN_DAYS=30
# 容器时区（影响日志与"今天"统计口径）
TZ=Asia/Shanghai
# --- compose 用：宿主机媒体库根目录（含 Movies/ TV/ 等子目录）---
# 必填！改成你的真实路径（/path/to/your/media 只是占位符，不改会挂载出空目录）
MEDIA_HOST_PATH=/path/to/your/media
# --- dashboard（可选）---
DASHBOARD_PORT=8099
# legacy：老部署的访问 token，等价一个 API key（?token=<值> 或 X-Dashboard-Token 头）。
# 新部署建议留空——首次访问监控页会进入创建管理员向导（账号密码 + 自动生成 API key）。
DASHBOARD_TOKEN=
